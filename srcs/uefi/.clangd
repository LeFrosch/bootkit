CompileFlags:
  Compiler: gcc
  Add:
    - -fpic 
    - -ffreestanding 
    - -fno-stack-protector 
    - -fno-stack-check 
    - -fshort-wchar 
    - -mno-red-zone 
    - -Wall 
    - -Wextra 
    - -Wconversion 
    - -Werror 
    - -std=c23 
    - -I../include
    - -I../../gnu-efi/inc
    - --target=x86_64-linux-gnu
